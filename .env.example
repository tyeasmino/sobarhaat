# Express API (events)
NEXT_PUBLIC_API_URL=https://sobarhaat-server.vercel.app

# BetterAuth (server-side only)
# Use http://localhost:3000 when both client and API run locally.
# On Vercel this must be the client origin, e.g. https://sobarhaat-client.vercel.app
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://...

# Google OAuth (needed for "Continue with Google")
# Google Cloud Console -> Credentials -> OAuth client ID -> Web application.
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://sobarhaat-client.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
